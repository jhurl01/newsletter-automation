# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key — needed for the research agent (web fetch + search loop).
# Sign up at console.anthropic.com. Separate from Claude Pro subscription.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Optional: Free formatting (recommended) ───────────────────────────────────
# Groq API key — used for the "Format Newsletter" step instead of Anthropic.
# Free tier at console.groq.com — no credit card required.
# If set, formatting costs $0. If not set, falls back to Anthropic (Haiku, ~$0.01/run).
GROQ_API_KEY=gsk_...

# ── Optional: Web search ──────────────────────────────────────────────────────
# Brave Search API key — needed for Eventbrite, SeatGeek, Songkick, etc.
# Free tier at api.search.brave.com — 2,000 queries/month free.
BRAVE_API_KEY=BSA...

# ── Optional: Override research model ────────────────────────────────────────
# Defaults to claude-haiku-4-5-20251001 (~$0.04-0.08/run).
# Use claude-sonnet-4-6 for better results (~$0.30-0.50/run).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
